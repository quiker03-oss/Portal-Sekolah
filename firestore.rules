rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Whitelist valid school collections for multi-tenant and superadmin synchronization
    match /schools/{schoolId}/{colName}/{docId} {
      allow read: if true;
      allow write: if colName in [
        'siswa',
        'guru',
        'kelas',
        'mapel',
        'absensi_siswa',
        'absensi_guru',
        'nilai',
        'nilai_harian',
        'catatan_rapor',
        'pengumuman',
        'berita',
        'galeri',
        'kas',
        'users',
        'settings',
        'sekolah',
        'landing_config',
        'school_accounts',
        'superadmin_user',
        'superadmin_logs'
      ];
    }
  }
}
