{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account for authentication and roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "guru", "superadmin"] },
        "nip": { "type": "string" },
        "guruId": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "username", "name", "role"]
    },
    "School": {
      "title": "School",
      "description": "School account config",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namaSekolah": { "type": "string" },
        "npsn": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Siswa": {
      "title": "Siswa",
      "description": "Student record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "qrId": { "type": "string" },
        "nomorInduk": { "type": "string" },
        "nisn": { "type": "string" },
        "namaLengkap": { "type": "string" },
        "kelas": { "type": "string" }
      }
    },
    "Guru": {
      "title": "Guru",
      "description": "Teacher record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "nama": { "type": "string" },
        "nip": { "type": "string" }
      }
    },
    "TransaksiKas": {
      "title": "TransaksiKas",
      "description": "Cash transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "jumlah": { "type": "number" },
        "kategori": { "type": "string" }
      }
    },
    "BelJadwal": {
      "title": "BelJadwal",
      "description": "School bell schedule entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "waktu": { "type": "string" },
        "keterangan": { "type": "string" },
        "pesanSuara": { "type": "string" },
        "aktif": { "type": "boolean" },
        "tipeBel": { "type": "string" },
        "hari": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "waktu", "keterangan"]
    },
    "UjianOnline": {
      "title": "UjianOnline",
      "description": "Online exams and question bank",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "judul": { "type": "string" },
        "mataPelajaran": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "SesiUjianSiswa": {
      "title": "SesiUjianSiswa",
      "description": "Student exam sessions, answers, and scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "ujianId": { "type": "string" },
        "siswaId": { "type": "string" },
        "status": { "type": "string" },
        "nilaiAkhir": { "type": "number" }
      }
    },
    "ExamImageMeta": {
      "title": "ExamImageMeta",
      "description": "Metadata for exam question and choice images stored in Firebase Storage",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "ujianId": { "type": "string" },
        "soalId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["soal", "pilihan"] },
        "choiceLetter": { "type": "string" },
        "url": { "type": "string" },
        "storagePath": { "type": "string" },
        "mimeType": { "type": "string" },
        "sizeBytes": { "type": "number" }
      },
      "required": ["id", "schoolId", "ujianId", "soalId", "url"]
    },
    "AiSoalReaderSession": {
      "title": "AiSoalReaderSession",
      "description": "Saved AI question reading and answering sessions parsed from uploaded files",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "guruId": { "type": "string" },
        "guruName": { "type": "string" },
        "judul": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "judul", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "School configurations"
    },
    "/schools/{schoolId}/siswa/{siswaId}": {
      "schema": { "$ref": "#/entities/Siswa" },
      "description": "Students"
    },
    "/schools/{schoolId}/guru/{guruId}": {
      "schema": { "$ref": "#/entities/Guru" },
      "description": "Teachers"
    },
    "/schools/{schoolId}/kas/{kasId}": {
      "schema": { "$ref": "#/entities/TransaksiKas" },
      "description": "Cash transactions"
    },
    "/schools/{schoolId}/bel_jadwal/{belId}": {
      "schema": { "$ref": "#/entities/BelJadwal" },
      "description": "School automatic bell schedules"
    },
    "/schools/{schoolId}/exams/{examId}": {
      "schema": { "$ref": "#/entities/UjianOnline" },
      "description": "Online school exams"
    },
    "/schools/{schoolId}/exam_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/SesiUjianSiswa" },
      "description": "Student exam sessions and submissions"
    },
    "/schools/{schoolId}/exam_images/{imageId}": {
      "schema": { "$ref": "#/entities/ExamImageMeta" },
      "description": "Exam image metadata linked to questions and Firebase Storage"
    },
    "/schools/{schoolId}/ai_soal_reader/{readerId}": {
      "schema": { "$ref": "#/entities/AiSoalReaderSession" },
      "description": "Saved AI automatic question reader sessions"
    }
  }
}
