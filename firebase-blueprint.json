{
  "entities": {
    "User": {
      "title": "User",
      "description": "User account for authentication and roles",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "username": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "guru", "superadmin"] },
        "nip": { "type": "string" },
        "guruId": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["id", "username", "name", "role"]
    },
    "School": {
      "title": "School",
      "description": "School account config",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "namaSekolah": { "type": "string" },
        "npsn": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "Siswa": {
      "title": "Siswa",
      "description": "Student record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "qrId": { "type": "string" },
        "nomorInduk": { "type": "string" },
        "nisn": { "type": "string" },
        "namaLengkap": { "type": "string" },
        "kelas": { "type": "string" }
      }
    },
    "Guru": {
      "title": "Guru",
      "description": "Teacher record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "nama": { "type": "string" },
        "nip": { "type": "string" }
      }
    },
    "TransaksiKas": {
      "title": "TransaksiKas",
      "description": "Cash transaction",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "jumlah": { "type": "number" },
        "kategori": { "type": "string" }
      }
    },
    "UjianOnline": {
      "title": "UjianOnline",
      "description": "Online exam definition and questions",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "judul": { "type": "string" },
        "mataPelajaran": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "JawabanSiswaUjian": {
      "title": "JawabanSiswaUjian",
      "description": "Student exam submissions and scores",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "ujianId": { "type": "string" },
        "siswaId": { "type": "string" },
        "status": { "type": "string" },
        "nilaiAkhir": { "type": "number" }
      }
    },
    "BelJadwal": {
      "title": "BelJadwal",
      "description": "School bell schedule entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "schoolId": { "type": "string" },
        "waktu": { "type": "string" },
        "keterangan": { "type": "string" },
        "pesanSuara": { "type": "string" },
        "aktif": { "type": "boolean" },
        "tipeBel": { "type": "string" },
        "hari": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "waktu", "keterangan"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/User" },
      "description": "User profiles"
    },
    "/schools/{schoolId}": {
      "schema": { "$ref": "#/entities/School" },
      "description": "School configurations"
    },
    "/schools/{schoolId}/siswa/{siswaId}": {
      "schema": { "$ref": "#/entities/Siswa" },
      "description": "Students"
    },
    "/schools/{schoolId}/guru/{guruId}": {
      "schema": { "$ref": "#/entities/Guru" },
      "description": "Teachers"
    },
    "/schools/{schoolId}/kas/{kasId}": {
      "schema": { "$ref": "#/entities/TransaksiKas" },
      "description": "Cash transactions"
    },
    "/schools/{schoolId}/ujian_online/{ujianId}": {
      "schema": { "$ref": "#/entities/UjianOnline" },
      "description": "Online exams"
    },
    "/schools/{schoolId}/jawaban_ujian/{jawabanId}": {
      "schema": { "$ref": "#/entities/JawabanSiswaUjian" },
      "description": "Exam submissions"
    },
    "/schools/{schoolId}/bel_jadwal/{belId}": {
      "schema": { "$ref": "#/entities/BelJadwal" },
      "description": "School automatic bell schedules"
    }
  }
}
