{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/ujian/session/:action",
      "destination": "/api/ujian/session/:action"
    },
    {
      "source": "/api/ujian/:action",
      "destination": "/api/ujian/:action"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api",
      "destination": "/api/index"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
