{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "functions": {
    "api/**/*.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/ujian/parse-docx",
      "destination": "/api/ujian/parse-docx"
    },
    {
      "source": "/api/ujian/parse-pdf",
      "destination": "/api/ujian/parse-pdf"
    },
    {
      "source": "/api/ujian/parse-text-soal",
      "destination": "/api/ujian/parse-text-soal"
    },
    {
      "source": "/api/ai/buat-soal",
      "destination": "/api/ai/buat-soal"
    },
    {
      "source": "/api/ai/regenerasi-soal",
      "destination": "/api/ai/regenerasi-soal"
    },
    {
      "source": "/api/ai/buat-modul",
      "destination": "/api/ai/buat-modul"
    },
    {
      "source": "/api/ai/buat-materi",
      "destination": "/api/ai/buat-materi"
    },
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
